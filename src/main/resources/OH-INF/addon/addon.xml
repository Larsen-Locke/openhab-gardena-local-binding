<?xml version="1.0" encoding="UTF-8"?>
<addon:addon id="gardenalocal" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:addon="https://openhab.org/schemas/addon/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/addon/v1.0.0 https://openhab.org/schemas/addon-1.0.0.xsd">

	<type>binding</type>
	<name>GARDENA Binding (local)</name>
	<description>Controls GARDENA smart irrigation controls and water controls and reads GARDENA smart sensors through the
		local WebSocket API of the GARDENA smart Gateway, without the GARDENA cloud.</description>
	<connection>local</connection>

	<discovery-methods>
		<discovery-method>
			<service-type>mdns</service-type>
			<discovery-parameters>
				<discovery-parameter>
					<name>mdnsServiceType</name>
					<value>_gardena-smart._tcp.local.</value>
				</discovery-parameter>
			</discovery-parameters>
		</discovery-method>
	</discovery-methods>

</addon:addon>
